rules_version = '2';

// ============================================================================
// Dageraad — Firestore security rules
//
// THE SITUATION THESE RULES EXIST IN (see README "Trust model"):
// We are on the free Spark plan, so there are no Cloud Functions. Resolution
// runs in a browser at the table — the REFEREE, ideally the neutral tablet.
// That means the referee genuinely must be able to read every player's card,
// and no rule can change that. What these rules do is make sure NOBODY ELSE
// can, except for the conscious trusted-group recovery route below.
//
// THE SINGLE MOST IMPORTANT RULE IN THIS FILE limits referee recovery to an
// active member, the explicit phrase `referee`, and only the two control
// fields. It is intentional social friction, not a secret against devtools.
//
// Design notes:
//  - There are NO mutable stats counters. Per-game results are append-only
//    documents under the room; profile stats are aggregated client-side by
//    reading them. That removes "who is allowed to increment my win count"
//    as a question entirely, and makes history tamper-evident.
//  - Late writes are blocked by matching a submission's windowIndex against
//    the room's current one, rather than by trusting clocks.
//  - THE SCOREBOARD IS NOT STORED. A latecomer's seed used to be a `seeded`
//    field on their own member document, which meant the number their score
//    starts at was a number they could type. It is now derived from
//    `joinedAtRound` and the append-only round records — see the members and
//    rounds blocks below, and session.ts for the arithmetic. The same reason
//    there are no win counters: a value a rule cannot check must not exist.
//  - No-self-vote is enforced here as well as in the UI (§7).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- utils
    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }
    function isReferee(roomId) {
      return signedIn() && roomDoc(roomId).refereeUid == uid();
    }
    function isHost(roomId) {
      return signedIn() && roomDoc(roomId).hostUid == uid();
    }
    function inPhase(roomId, p) {
      return roomDoc(roomId).phase == p;
    }
    function changed(field) {
      return !(field in resource.data)
        || request.resource.data[field] != resource.data[field];
    }
    function roundNeverRewinds() {
      return !('currentRound' in resource.data)
        || (
          request.resource.data.currentRound is int
          && request.resource.data.currentRound >= resource.data.currentRound
          && request.resource.data.currentRound <= resource.data.currentRound + 1
        );
    }
    // The round NOW BEING PLAYED. 0 in the lobby, N during and after round N.
    // Somebody joining is measured against this + 1; a round record against it
    // exactly. Both are pinned here rather than trusted from the write.
    function currentRound(roomId) {
      return roomDoc(roomId).currentRound;
    }
    /** Practice evenings never reach the all-time record, so bots may play. */
    function isPractice(roomId) {
      return roomDoc(roomId).mode == 'practice';
    }
    function isBotPlayer(roomId, playerUid) {
      return get(/databases/$(database)/documents/rooms/$(roomId)/players/$(playerUid))
        .data.isBot == true;
    }
    function ordinaryVoteFields() {
      return request.resource.data.keys().hasOnly(
        ['round', 'target', 'abstain', 'readyToVote', 'castAt']
      );
    }
    function currentVoteIsFinal(roomId) {
      return ('round' in resource.data)
        && resource.data.round == currentRound(roomId)
        && resource.data.target != null;
    }
    function isFinalNamedVote(roomId, voterUid) {
      return request.resource.data.round == currentRound(roomId)
        && request.resource.data.target is string
        && request.resource.data.target != voterUid
        && roomDoc(roomId).seating.hasAny([request.resource.data.target])
        && request.resource.data.abstain == false;
    }
    // Lobby members may arrange the physical table before the game starts.
    // They may reorder existing seats, or add only their own UID as one new
    // seat; they cannot remove, replace, or duplicate anybody already seated.
    function memberArrangesLobbySeating(roomId) {
      return inPhase(roomId, 'lobby')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['seating'])
        && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(uid()))
        && request.resource.data.seating.size() <= 12
        && request.resource.data.seating.toSet().size()
             == request.resource.data.seating.size()
        && request.resource.data.seating.toSet()
             .hasAll(resource.data.seating.toSet())
        && (
          (request.resource.data.seating.size() == resource.data.seating.size()
            && request.resource.data.seating.toSet().size()
               == resource.data.seating.toSet().size())
          || (request.resource.data.seating.size() == resource.data.seating.size() + 1
            && request.resource.data.seating.toSet().size()
               == resource.data.seating.toSet().size() + 1
            && request.resource.data.seating.toSet().hasAll([uid()])
            && !resource.data.seating.toSet().hasAny([uid()]))
        );
    }
    // Emergency recovery is a deliberate, trusted-group action. Firestore
    // cannot observe a menu click, so the phrase is checked on the write. It is
    // intentionally not a secret; the app uses it as a conscious confirmation.
    function memberClaimsEmergencyControl(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(uid()))
        && get(/databases/$(database)/documents/rooms/$(roomId)/members/$(uid()))
             .data.leftAtRound == null
        && request.resource.data.recoveryPhrase == 'referee'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['hostUid', 'refereeUid', 'recoveryPhrase'])
        && (changed('hostUid') || changed('refereeUid'))
        && request.resource.data.hostUid == uid()
        && request.resource.data.refereeUid == uid();
    }
    // ---------------------------------------------------------------- rooms
    // The room document is PUBLIC to anyone with the link, by design: it holds
    // the active role list, the seating order, the phase, and the computed
    // timeline. All of that is information everyone at the table already has,
    // and the timeline is deliberately derived from the public role set alone
    // (see timeline.ts) so publishing it leaks nothing.
    match /rooms/{roomId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.hostUid == uid()
        // Practice unless somebody deliberately said otherwise. The failure we
        // can afford is a real evening not counting; the one we cannot is a
        // test round in append-only history with no delete path.
        && request.resource.data.mode in ['practice', 'official']
        && request.resource.data.discussionMs is int
        && request.resource.data.discussionMs >= 60000
        && request.resource.data.discussionMs <= 7200000
        && request.resource.data.discussionEndsAt == null
        && request.resource.data.practiceSkipDiscussion == false
        // The creator may hand the referee role to the tablet. An explicit,
        // trusted-group recovery route is the sole way it can move later.
        && request.resource.data.refereeUid is string
        && request.resource.data.phase == 'lobby';

      // ***** THE LOAD-BEARING RULE *****
      // Normal updates never reassign the referee or host. The separate
      // recovery route is intentionally narrow and phrase-confirmed.
      allow update: if signedIn()
        && (
          ((isHost(roomId) || isReferee(roomId) || memberArrangesLobbySeating(roomId))
            && !changed('refereeUid')
            && !changed('hostUid')
        // Whether this evening counts is fixed when the room is made. A room
        // that could be promoted afterwards would let a good night be
        // retconned into the record and a bad one quietly demoted — worse
        // than having no history at all, because you could not tell.
        && !changed('mode')
        // The deck is public setup, but once cards have been dealt changing it
        // would make the published timeline disagree with the actual deal.
        && (!changed('activeRoles')
            || ((isHost(roomId) || isReferee(roomId)) && inPhase(roomId, 'lobby')))
        && (!changed('config')
            || ((isHost(roomId) || isReferee(roomId)) && inPhase(roomId, 'lobby')))
        // One shared timer for the evening, chosen before the room exists.
        && !changed('discussionMs')
        && (!changed('discussionEndsAt') || isReferee(roomId))
        // The practice shortcut is never accepted in an official room.
        && (!changed('practiceSkipDiscussion')
            || (isReferee(roomId) && (
                 (isPractice(roomId)
                  && inPhase(roomId, 'day')
                  && request.resource.data.practiceSkipDiscussion == true)
                 || (request.resource.data.phase == 'night'
                     && request.resource.data.practiceSkipDiscussion == false)
               )))
            // currentRound only ever goes forward. It is what a joining member's
            // `joinedAtRound` is pinned to, and therefore the sole input to their
            // seed: rewinding it would let the referee re-admit somebody against a
            // floor the evening has already moved past.
            && roundNeverRewinds())
          // The recovery path may change ONLY who controls the room, and needs
          // the explicit phrase required by the app's warning dialog.
          || memberClaimsEmergencyControl(roomId)
        );

      allow delete: if isHost(roomId);

      // ------------------------------------------------------------ players
      // Public per-player info: display name, avatar, seat. Everyone can read
      // this — it is what the shared tablet and the seating circle render.
      match /players/{playerUid} {
        allow read: if signedIn();

        // You may only add yourself — and AT ANY TIME, not just in the lobby.
        // A room is an evening (session.ts): somebody arrives at round three
        // and is seated when the next round starts. The lobby-only rule that
        // used to be here dates from when a room was a single game, and it
        // would have refused every real mid-evening arrival.
        // Yourself, at any time. NOT marked as a bot: a human able to flag
        // their own document isBot would be a human the controlling browser is
        // then allowed to vote on behalf of, which is the single thing the
        // narrow bot-vote rule below exists to prevent.
        allow create: if signedIn()
          && playerUid == uid()
          && request.resource.data.keys().hasOnly(
               ['displayName', 'avatar', 'joinedAt']
             );

        // ...or an AI player, added by the controlling browser to fill out a
        // PRACTICE table. Practice is checked against the room rather than
        // trusted from the write: a bot in an official evening would put
        // invented results into a permanent record with no delete path.
        allow create: if isReferee(roomId)
          && inPhase(roomId, 'lobby')
          && isPractice(roomId)
          && request.resource.data.keys().hasOnly(
               ['displayName', 'avatar', 'joinedAt', 'isBot']
             )
          && request.resource.data.isBot == true;

        // Your own name and picture, whenever. NOTE WHAT IS NOT HERE: a seat.
        // Seat order is the room document's ordered uid list, written by the
        // referee at the round boundary — the Dorpsgek's shift depends on a
        // stable adjacency (§13), and a seat number living in a document its
        // own player can write is a seat number that player can choose.
        allow update: if signedIn()
          && (playerUid == uid() || isHost(roomId))
          && request.resource.data.keys().hasOnly(
               ['displayName', 'avatar', 'joinedAt']
             );

        // Going home is a member update, not a deletion: the rounds you played
        // still happened. This stays for tidying up an unstarted lobby.
        allow delete: if signedIn()
          && inPhase(roomId, 'lobby')
          && (playerUid == uid() || isHost(roomId));

        // ...and separately, an AI player removed before the first deal. Kept
        // as its own rule rather than folded into the line above: adding
        // `isReferee` there would have quietly given the controlling browser
        // the power to delete a HUMAN, which is not what removing a bot needs.
        allow delete: if isReferee(roomId)
          && inPhase(roomId, 'lobby')
          && isPractice(roomId)
          && isBotPlayer(roomId, playerUid);
      }

      // ------------------------------------------------------------ private
      // A player's dealt role, current card, and everything they have privately
      // learned. THIS IS THE SECRET DATA.
      match /private/{playerUid} {
        // Only you, and the referee who has to compute the night.
        allow read: if signedIn()
          && (playerUid == uid() || isReferee(roomId));

        // Only the referee writes. A player must never be able to edit their
        // own role, or to fabricate a reveal.
        allow write: if isReferee(roomId);
      }

      // -------------------------------------------------------------- engine
      // The full night state: every card, every slot, the whole deal. Referee
      // only. Nothing else in the app should ever read this.
      match /engine/{docId} {
        allow read, write: if isReferee(roomId);
      }

      // --------------------------------------------------------- submissions
      // Night choices. A player writes their own; only the referee reads them,
      // because knowing who someone targeted often reveals what they are.
      match /submissions/{playerUid} {
        allow read: if signedIn()
          && (playerUid == uid() || isReferee(roomId));

        // You may write or change your choice ONLY while the window you
        // submitted for is still the room's current window. This is what stops
        // a late write after seeing a reveal, without trusting client clocks.
        allow create, update: if signedIn()
          && playerUid == uid()
          && inPhase(roomId, 'night')
          && (!('round' in request.resource.data)
              || request.resource.data.keys().hasOnly(
                   ['round', 'windowIndex', 'choices', 'submittedAt']
                 ))
          && (!('round' in request.resource.data)
              || request.resource.data.round == currentRound(roomId))
          && request.resource.data.windowIndex == roomDoc(roomId).nightWindowIndex;

        allow delete: if false;
      }

      // -------------------------------------------------------------- votes
      // Voting is simultaneous (§7), so a vote must stay hidden until everyone
      // has cast one — otherwise the last voter sees the tally first.
      match /votes/{playerUid} {
        allow read: if signedIn()
          && (playerUid == uid()
              || isReferee(roomId)
              || inPhase(roomId, 'results'));

        // Two phases can write here, and for different reasons.
        //
        // During 'voting': one final named vote. It cannot be changed.
        //
        // During 'day' (the discussion): ABSTAIN ONLY. The "vote not to vote"
        // toggle is live from the first second and a majority counts at any
        // moment (§7, revised 2026-08-26) — which happens while the room is
        // still in 'day', so a voting-only rule would silently reject every
        // abstain and the whole mechanic would appear to do nothing.
        //
        // Naming a target is still confined to 'voting'. Letting someone lock a
        // target in during the discussion would quietly turn a simultaneous
        // vote into a first-mover one, even though nobody can read it yet.
        // A vote document also carries `readyToVote` — "let us open the
        // ballot now". It is a decision about the CLOCK rather than the
        // outcome, so it is allowed during the discussion exactly as an
        // abstain is, and it is subject to the same refusals: still no self
        // vote, and still no named target before voting opens. Asking to vote
        // must not become a way to smuggle a target in early.
        allow create: if signedIn()
          && playerUid == uid()
          && ordinaryVoteFields()
          && (
               (inPhase(roomId, 'voting') && isFinalNamedVote(roomId, playerUid))
               || (inPhase(roomId, 'day')
                   && request.resource.data.round == currentRound(roomId)
                   && request.resource.data.target == null
                   && request.resource.data.abstain is bool)
             );

        // Discussion toggles stay reversible. Once a named ballot exists for
        // this round, no update path may alter it — not its target, not an
        // abstain flag, and not a ready toggle.
        allow update: if signedIn()
          && playerUid == uid()
          && ordinaryVoteFields()
          && !currentVoteIsFinal(roomId)
          && (
               (inPhase(roomId, 'voting') && isFinalNamedVote(roomId, playerUid))
               || (inPhase(roomId, 'day')
                   && request.resource.data.round == currentRound(roomId)
                   && request.resource.data.target == null
                   && request.resource.data.abstain is bool)
             );

        // An AI PLAYER'S vote, cast by the controlling browser because there
        // is nobody behind that seat. Deliberately NOT a general "the referee
        // may vote as anyone": every clause below has to hold, and the one
        // that matters is that the target really is a bot. Without it, a
        // referee quietly voting for a human would be a write no rule could
        // tell from this one.
        //
        // Practice only, so an invented vote can never reach the all-time
        // record. Same phase rules and the same no-self-vote as a person's.
        allow create: if isReferee(roomId)
          && isPractice(roomId)
          && isBotPlayer(roomId, playerUid)
          && ordinaryVoteFields()
          && inPhase(roomId, 'voting')
          && isFinalNamedVote(roomId, playerUid);

        allow update: if isReferee(roomId)
          && isPractice(roomId)
          && isBotPlayer(roomId, playerUid)
          && ordinaryVoteFields()
          && !currentVoteIsFinal(roomId)
          && inPhase(roomId, 'voting')
          && isFinalNamedVote(roomId, playerUid);

        // A dead phone must not deadlock a mandatory ballot. The referee may
        // cast one missing player's final target only through the conscious
        // `takeover` path. This never overwrites a ballot already cast.
        allow create: if isReferee(roomId)
          && inPhase(roomId, 'voting')
          && request.resource.data.keys().hasOnly(
               ['round', 'target', 'abstain', 'readyToVote', 'castAt', 'takeoverPhrase']
             )
          && request.resource.data.takeoverPhrase == 'takeover'
          && roomDoc(roomId).seating.hasAny([playerUid])
          && roomDoc(roomId).seating.hasAny([request.resource.data.target])
          && isFinalNamedVote(roomId, playerUid);

        allow update: if isReferee(roomId)
          && inPhase(roomId, 'voting')
          && !currentVoteIsFinal(roomId)
          && request.resource.data.keys().hasOnly(
               ['round', 'target', 'abstain', 'readyToVote', 'castAt', 'takeoverPhrase']
             )
          && request.resource.data.takeoverPhrase == 'takeover'
          && roomDoc(roomId).seating.hasAny([playerUid])
          && roomDoc(roomId).seating.hasAny([request.resource.data.target])
          && isFinalNamedVote(roomId, playerUid);

        allow delete: if false;
      }

      // ------------------------------------------------------------ members
      // Who is in the EVENING, as opposed to who is seated in the round now
      // being played. A room is a session (session.ts): people arrive at round
      // three and leave after round five, and neither should end the night.
      //
      // ***** WHY THERE IS NO `seeded` FIELD *****
      // A latecomer starts level with whoever is currently last, so they join
      // at the back of the pack rather than below it. That number used to be
      // written HERE, by the arriving client, into a document that client owns.
      // Which meant the score the evening starts you on was a score you could
      // type: `seeded: 9999` from devtools won the night, and nothing in this
      // file could refuse it — a rule can decide who may write a document, not
      // whether 9999 was the correct floor at round four, which needs the whole
      // evening replayed and rules cannot replay anything.
      //
      // So it is not stored. It is recomputed from `joinedAtRound` and the
      // round records below, neither of which the joiner controls. The key
      // allowlist is what keeps it that way: re-adding the field is rejected
      // at the database, not merely ignored by whichever client remembered to.
      match /members/{memberUid} {
        allow read: if signedIn();

        // You add yourself; the host may add somebody whose phone died.
        // `joinedAtRound` is pinned to the room's CURRENT round — this single
        // comparison is what makes the derived seed unforgeable, because
        // joining is the only moment a player has any say over it at all.
        // A bot's membership, written by the controlling browser. Same shape
        // as anybody's, so a bot is seated by the ordinary round-boundary
        // logic rather than by anything that knows what a bot is.
        allow create: if isReferee(roomId)
          && isPractice(roomId)
          && inPhase(roomId, 'lobby')
          && request.resource.data.keys().hasOnly(
               ['uid', 'joinedAtRound', 'leftAtRound', 'friendId', 'friendName']
             )
          && request.resource.data.uid == memberUid
          && request.resource.data.joinedAtRound is int
          // Pinned exactly as a human's is. A bot that could name its own
          // joining round would be a bot with a score floor, and the floor is
          // derived from this number for everybody alike.
          && request.resource.data.joinedAtRound == currentRound(roomId) + 1
          && request.resource.data.leftAtRound == null
          && request.resource.data.friendId == ''
          && isBotPlayer(roomId, memberUid);

        allow create: if signedIn()
          && (memberUid == uid() || isHost(roomId))
          && request.resource.data.keys().hasOnly(
               ['uid', 'joinedAtRound', 'leftAtRound', 'friendId', 'friendName']
             )
          && request.resource.data.uid == memberUid
          && request.resource.data.joinedAtRound is int
          // NEXT round, not the current one: you join for the game about to be
          // dealt, because there is no card to hand somebody who walks in at
          // second twenty. In the lobby currentRound is 0 and this is 1, which
          // is the same code path rather than a special case.
          && request.resource.data.joinedAtRound == currentRound(roomId) + 1
          && request.resource.data.leftAtRound == null;

        // The only legitimate update is going home: null -> a round number,
        // once, and never a round already in the past. Backdating a departure
        // would erase rounds you actually played, and `joinedAtRound` must
        // never move at all — it is the seed.
        allow update: if signedIn()
          && (memberUid == uid() || isHost(roomId))
          && request.resource.data.keys().hasOnly(
               ['uid', 'joinedAtRound', 'leftAtRound', 'friendId', 'friendName']
             )
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.joinedAtRound == resource.data.joinedAtRound
          && (
               // going home
               (resource.data.leftAtRound == null
                 && request.resource.data.leftAtRound is int
                 && request.resource.data.leftAtRound >= currentRound(roomId))
               // ...or coming back, which re-uses the ORIGINAL joinedAtRound
               // and therefore the original seed. Otherwise stepping out for a
               // round would be a way to top your score up off the bottom.
               || (resource.data.leftAtRound != null
                 && request.resource.data.leftAtRound == null)
             );

        // Membership is history. A round you played happened whether or not
        // you are still in the room, and the scoreboard is rebuilt from it.
        //
        // The one exception is an AI player removed before the first deal:
        // nothing has happened yet, and leaving the membership behind would
        // keep a bot on the next round's roster and on the scoreboard. A bot
        // has no history to preserve, because practice writes none.
        allow delete: if isReferee(roomId)
          && inPhase(roomId, 'lobby')
          && isPractice(roomId)
          && isBotPlayer(roomId, memberUid);
      }

      // ------------------------------------------------------------- rounds
      // One finished game of the evening. APPEND-ONLY, exactly like /results
      // and for a stronger reason: these documents are now the ONLY input to
      // the scoreboard, so an editable round is an editable score.
      //
      // The document id is the round number, and it must match the `round`
      // field. Create-only already stops a round being overwritten; binding
      // the id stops the same round being recorded twice under a second id.
      match /rounds/{roundId} {
        allow read: if signedIn();

        allow create: if isReferee(roomId)
          && request.resource.data.keys().hasOnly(
               ['round', 'activeRoles', 'seatCount', 'outcome', 'results',
                'recordedAt']
             )
          && request.resource.data.round is int
          && request.resource.data.round == currentRound(roomId)
          && roundId == string(request.resource.data.round)
          && request.resource.data.results is list
          && request.resource.data.seatCount is int;

        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------- profiles
    // Persistent identity. Readable by anyone signed in, because tapping a
    // player to see their history is the night phase's cover traffic (§5.4) —
    // it has to work for everyone at the table.
    match /profiles/{profileUid} {
      allow read: if signedIn();

      // You own your name and picture. Note there are deliberately no stats
      // fields here to write: stats live in the append-only results documents.
      allow create, update: if signedIn()
        && profileUid == uid()
        && request.resource.data.keys().hasOnly(
             ['displayName', 'avatar', 'language', 'createdAt', 'updatedAt']
           );

      allow delete: if signedIn() && profileUid == uid();
    }

    // ---------------------------------------------------------- calibration
    // Timing samples feeding window-duration calibration (telemetry.ts).
    // Append-only. Contains no role information — only how long a decision
    // took, keyed by role NAME, never by who was playing it.
    match /calibration/{sampleId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['role', 'key', 'latencyMs', 'outcome', 'paused', 'sessionId', 'createdAt']
           );
      allow update, delete: if false;
    }

    // -------------------------------------------------------------- friends
    // The group's shared address book: which humans exist, so a history can
    // follow a person across phones and rooms (see app/friend.ts).
    //
    // Deliberately owned by nobody and protected by nothing. This is eight
    // people who know each other, and claiming to be one of them buys you
    // their board game scoreboard and NOTHING inside a game — every rule in
    // this file still keys off the uid. Putting a password on it would be
    // security theatre with a real cost in friction.
    //
    // What the rules DO enforce is shape: a friend is an id, a name and a
    // date, and nothing that could ever be worth points.
    match /friends/{friendId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id', 'displayName', 'createdAt'])
        && request.resource.data.id == friendId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40;

      // Renaming is allowed — people change what they go by, and the id is
      // what history is keyed on, so a rename costs nothing. The id itself
      // never moves, because moving it would silently merge two histories.
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['id', 'displayName', 'createdAt'])
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0;

      // A deleted friend is a deleted history. The rows would survive and
      // point at nobody, which is worse than an unused name in a list.
      allow delete: if false;
    }

    // -------------------------------------------------------------- history
    // The group's all-time record: one document per player per OFFICIAL
    // round, across every evening.
    //
    // Append-only and immutable, like the per-room results it mirrors, and for
    // a stronger reason: this is the only thing the group's history is made
    // of, so an editable row is an editable year.
    //
    // THERE IS NO STORED TOTAL, deliberately. Totals are recomputed from these
    // rows on every read (stats/alltime.ts). A stored aggregate is a number
    // somebody has to be trusted to have incremented correctly, and this
    // schema has already been bitten once by exactly that.
    //
    // Everything written here is PUBLIC AT DAWN: roles become public when the
    // game ends (§6.0) and the vote outcome is already in the per-room
    // results. Nothing about the night appears — no targets, no reveals, no
    // unrevealed card ever gets named.
    match /history/{entryId} {
      allow read: if signedIn();

      allow create: if signedIn()
        // Only the referee of the room being recorded. A player writing their
        // own history row is a player writing their own scoreboard.
        && isReferee(request.resource.data.roomId)
        // ...and only for an evening that was declared official when it was
        // created. Checked against the room, never trusted from the write.
        && roomDoc(request.resource.data.roomId).mode == 'official'
        && request.resource.data.keys().hasOnly([
             'roomId', 'round', 'friendId', 'name', 'seat',
             'originalRole', 'finalRole', 'won', 'voteOutcome',
             'suspicionAccuracy', 'recordedAt'
           ])
        && request.resource.data.round is int
        && request.resource.data.seat is int
        && request.resource.data.won is bool
        && request.resource.data.friendId is string
        && request.resource.data.friendId.size() > 0
        // The id binds the row to its room, round and player, so recording the
        // same round twice is a collision rather than a second row — a referee
        // refreshing a tab cannot double-count a year.
        && entryId == request.resource.data.roomId + '_'
             + string(request.resource.data.round) + '_'
             + request.resource.data.friendId;

      allow update, delete: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
